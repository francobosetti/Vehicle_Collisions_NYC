\section{Data Preparation}

Prepare the data for processing:

<<echo=FALSE, message=FALSE, warning=FALSE>>=
library(rcompanion)
library(ggplot2)
library(dplyr)
library(broom)
library(lubridate)
library(readr)
library(ggspatial)
library(sf)
library(prettymapr)
library(raster)
library(gridExtra)
library(ggeffects)
library(forcats)
@


<<echo=FALSE, message=FALSE, warning=FALSE>>=
read.csv(file = "data/Motor_Vehicle_Collisions_-_Crashes.csv") %>%
mutate(CRASH.DATE=as.Date(CRASH.DATE, format = "%m/%d/%Y"),
       BOROUGH=factor(BOROUGH),
       YEAR_MONTH=format(CRASH.DATE, "%Y-%m"),
       YEAR=format(CRASH.DATE, "%Y"),
       round_location=paste("(", round(LATITUDE, digits = 4), ", ", 
                            round(LONGITUDE, digits = 4), ")", sep = ""),
       HOUR=as.numeric(sub("\\:.*", "", CRASH.TIME))) -> nyc

@

\subsection{Secondary Datasets}
While the New York Collisions dataset provides many useful columns on which to perform analysis, more insight can be gained when considering other forms of data. Below we import these auxillary datasets:

<<echo=FALSE, message=FALSE, warning=FALSE>>=
twitter_train <- read.csv("data/1_TrainingSet_3Class.csv", header=FALSE)
twitter_test <- read.csv("data/1_TestSet_3Class.csv", header=FALSE)

# add headers
names(twitter_train) <- c("class", "tweet_id", "tweet_text")
names(twitter_test) <- c("class", "tweet_id", "tweet_text")

# Combine 
#twitter <- rbind(twitter_train, twitter_test) old method, no deplyr
bind_rows(twitter_train, twitter_test) %>%
mutate(clean_tweet_id=gsub("^s", "", tweet_id)) -> twitter

@


The VZV dataset on speed limits contains a map of city speed limits. Each speed limit is attached to a street or section of a street, specified by a sequence of coordinates. We can use those coordinates to map this dataset to our original nyc dataset to create a combined dataframe containing all the values of the nyc dataset, but with a new column representing the speed limit. To avoid any duplicated values caused by many-to-many matching, we first pre-process the speed limits dataset to ensure that for each location value there is only one speed limit value, taking the maximum if there are multiple options. 
<<echo=FALSE, message=FALSE, warning=FALSE>>=
sp_limits <- read.csv("data/VZV_Speed_Limits_20251002.csv")

# Format the sp_limits latitude and longitude
# Pre-process the speed limit data
library(dplyr)
lats <- strsplit(sp_limits$the_geom, " ") %>%
  lapply(FUN=function(x) substr(x[3], 1, nchar(x[3])-1)) %>%
  as.numeric()
longs <- strsplit(sp_limits$the_geom, " ") %>%
  lapply(FUN=function(x) substr(x[2], 3, nchar(x[3]))) %>%
  as.numeric()
loc<- paste("(", round(lats, digits = 4), ", ", round(longs, digits = 4), ")", sep = "")
sp_lim_proc <- mutate(sp_limits, latitude = lats, longitude = longs, ROUND.LOCATION =loc) %>%
  rename(SPEED.LIMIT = postvz_sl)

sp_limits_filt <- sp_lim_proc %>%
  group_by(ROUND.LOCATION) %>%
  slice_max(order_by = SPEED.LIMIT, n=1, with_ties = FALSE) %>%
  ungroup()
  

# Create dataframe of the speed limits combined with the rest of the data
combined <- # add speed limit data to nyc dataset
  mutate(nyc, ROUND.LOCATION = paste("(", round(LATITUDE, digits = 4), ", ", 
                                     round(LONGITUDE, digits = 4), ")", sep = "")) %>%
  filter(!is.na(LATITUDE), !is.na(LONGITUDE)) %>%
  inner_join(dplyr::select(sp_limits_filt, SPEED.LIMIT, ROUND.LOCATION), by="ROUND.LOCATION")
@


The Motor Vehicle Collisions vehicle table contains details on each vehicle involved in a collision. Each row represents a particular vehicle with certain attributes. The collision ID of the main dataset is also present in this dataset, although values are no longer unique as multiple vehicles can contribute to one collision.
<<echo=FALSE, message=FALSE, warning=FALSE>>=
nyv <- read.csv(file = "data/Motor_Vehicle_Collisions_-_Vehicles_20250930.csv")
nyv$CRASH_DATE <- as.Date(nyv$CRASH_DATE, format = "%m/%d/%Y")
nyv$YEAR <- as.numeric(format(nyv$CRASH_DATE, "%Y"))

veh_per_col <- tapply(nyv$COLLISION_ID, nyv$COLLISION_ID, length)
nyc$VEHICLE_COUNT <- veh_per_col[as.character(nyc$COLLISION_ID)]

#rows where vehicle occupants is not NA, 
#not 0 and not above 60 (capacity of New York Bus)
ex_pas_move <- (!is.na(nyv$VEHICLE_OCCUPANTS))&(nyv$VEHICLE_OCCUPANTS %in% 1:60) 
pass_per_veh <- tapply(nyv$VEHICLE_OCCUPANTS[ex_pas_move],
                       nyv$COLLISION_ID[ex_pas_move],
                       mean)
nyc$AV_PASSENGERS <- pass_per_veh[as.character(nyc$COLLISION_ID)]

#Select only vehicle year models from 1920-2025 to clean the data
ex_veh_year <- (!is.na(nyv$VEHICLE_YEAR))&
               (nyv$VEHICLE_YEAR %in% 1920:2025) &
               (nyv$VEHICLE_YEAR <= nyv$YEAR)
               
av_car_made <- tapply(nyv$VEHICLE_YEAR[ex_veh_year],
                      nyv$COLLISION_ID[ex_veh_year],
                      mean)
nyc$AV_VEH_YEAR <- av_car_made[as.character(nyc$COLLISION_ID)]

#Add average vehicle age column.
#Note that vehicles year sometimes given as year rounded up.
nyc$AV_VEH_AGE <-  as.numeric(nyc$YEAR) - nyc$AV_VEH_YEAR
@

