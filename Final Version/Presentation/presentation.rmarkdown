)
grid.text(
  "Total Crashes in this area",
  x = unit(0.2, "npc"),
  y = unit(0.94, "npc"),
  just = c("left", "top"),
  gp=gpar(fontsize=10)
)
for (i in 1:100) {
  grid.rect(
    x = unit(.24, "npc"),
    y = unit(.8, "npc") + unit(.1, "npc") * (i - 1) / 100,
