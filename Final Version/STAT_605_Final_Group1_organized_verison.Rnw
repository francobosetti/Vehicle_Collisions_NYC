\section{Appendices}

\subsection{Appendix A: Piecewise Linear Trends in Total Crashes per Year by Borough}
<<echo=FALSE, message=FALSE, warning=FALSE, fig.height=13, fig.width=11, fig.align='center'>>=
# Appendix A: Piecewise Linear Trends in Total Crashes per Year by Borough
dat <- nyc %>%
  filter(BOROUGH != "") %>%
  group_by(BOROUGH) %>%
  count(YEAR) %>%
  ungroup() %>%
  mutate(period = ifelse(YEAR <= 2019, "2019 and before", "2020 and after"))

ggplot(dat, aes(x = YEAR, y = n, color = BOROUGH)) +
  geom_point() +
  geom_smooth(aes(linetype = period, group = interaction(BOROUGH, period)),
              method = "lm",
              se = FALSE) +
  labs(title = "Piecewise Linear Trends in Total Crashes per Year by Borough",
       x = "Year",
       y = "Number of Crashes",
       linetype = "Time Period")

@

\subsection{Appendix B: Total Number of Accidents per Time of Day}
<<echo=FALSE, message=FALSE, warning=FALSE, fig.height=13, fig.width=11, fig.align='center'>>=
# Appendix B: Total Number of Accidents per Time of Day
layout(mat = 1)
times <- nyc$CRASH.TIME
hours <- as.numeric(sub("\\:.*", "", times))
par(tck = -0.015, mgp = c(1.5, 0.4, 0), mar = c(3, 3, 3, 1.5))
hist(hours, xlab = "Time of day", ylab = "Number of accidents", axes = FALSE, 
     main="Total Number of Accidents per Time of Day", 
     breaks=seq(-0.5, 23.5, 1))

labels <- c("12:00AM", "3:00AM", "6:00AM", "9:00AM", 
            "12:00PM", "3:00PM", "6:00PM", "9:00PM")
axp <- seq(0, 23, by=3)
axis(1, at=axp, labels = labels)
axp2 <- seq(0, 150000, by=50000)
axis(2, at = axp2, labels = axp2)

@

\subsection{Appendix C: All Accidents}
<<echo=FALSE, message=FALSE, warning=FALSE, results='hide'>>=
# Appendix C: All Accidents
#plot the car crashes on the NYC map
small_sample_sf <- filter(combined, between(LONGITUDE, -74.26, -73.70) & 
                            between(LATITUDE, 40.49, 40.92)) %>%
  sample_n(3000) %>%
  st_as_sf(coords = c("LONGITUDE", "LATITUDE"), crs = 4326) %>%
  st_transform(3857)

nyc_bbox <- st_bbox(small_sample_sf)

ggplot(small_sample_sf)+
  annotation_map_tile(type = "cartolight", zoom=11)+
  stat_density_2d(
    aes(x = st_coordinates(small_sample_sf)[,1],
        y = st_coordinates(small_sample_sf)[,2],
        fill = after_stat(level),
        alpha = after_stat(level)),
    geom = "polygon",
    contour = TRUE
  ) +
  scale_fill_viridis_c(option = "magma") +
  scale_alpha(range = c(0.05, 0.4), guide = "none") +
  coord_sf(xlim = c(nyc_bbox["xmin"], nyc_bbox["xmax"]),
           ylim = c(nyc_bbox["ymin"], nyc_bbox["ymax"]),
           expand = FALSE) +
  labs(title = "NYC Accident Density Heatmap") +
  xlab("Longitude Coordinates") +
  ylab("Latitude Coordinates") +
  guides(fill = guide_colorbar(title = "Density"))

@

\subsection{Appendix D: Highway Accidents}
<<echo=FALSE, message=FALSE, warning=FALSE, fig.height=13, fig.width=11, fig.align='center'>>=
# Appendix D: Highway Accidents
# Find the accidents that occurred on high speed roads
filter(combined, between(LONGITUDE, -74.26, -73.70) & 
         between(LATITUDE, 40.49, 40.92), SPEED.LIMIT > 40) %>%
  sample_n(3000) %>%
  st_as_sf(coords = c("LONGITUDE", "LATITUDE"), crs = 4326) %>%
  st_transform(3857) %>%
  ggplot() +
  annotation_map_tile(type = "cartolight", zoom = 11) +
  geom_sf( size = 1) +
  coord_sf(xlim = c(nyc_bbox["xmin"], nyc_bbox["xmax"]),
           ylim = c(nyc_bbox["ymin"], nyc_bbox["ymax"]),
           expand = FALSE) +
  labs(title = "Car accidents on high speed roads (>40mph)")

@

